# Hosted project: Supabase dashboard > Project Settings > API Keys.
# Local: run `pnpm supabase:env` after `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Base URL used in login links/OAuth redirects. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Required for Instagram and local integration tests. Server only.
SUPABASE_SECRET_KEY=

# Instagram Login (optional). Never prefix these with NEXT_PUBLIC_.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Only needed if the Meta app signing secret differs from INSTAGRAM_APP_SECRET.
# INSTAGRAM_WEBHOOK_APP_SECRET=
# INSTAGRAM_GRAPH_VERSION=v27.0
