# Hosted project: Supabase dashboard > Project Settings > API Keys.
# Local: run `pnpm supabase:env` after `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Base URL used in login links/OAuth redirects. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Integration tests only (local Supabase). Never expose this to the browser.
SUPABASE_SECRET_KEY=
